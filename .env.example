# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_NASA_API_KEY: Optional. Free key from https://api.nasa.gov (instant signup).
# Used for api.nasa.gov EPIC (Earth observation mission) and APOD (mission-end image reward).
# Without it the app falls back to the shared DEMO_KEY (about 30 requests/hour per IP), results are
# cached for the session, and every feature has an offline fallback.
# Note: VITE_ variables are bundled into the client. NASA keys are rate-limit keys, not secrets.
VITE_NASA_API_KEY=""
